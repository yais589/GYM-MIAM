# URL pública del backend Express, incluyendo el prefijo /api.
# Ejemplo: https://tu-backend.onrender.com/api
VITE_API_URL=

# El catálogo usa el backend local (/api/storeitems), que es el mismo origen
# que controla el stock y los pagos. Solo define esta variable si usas otra API.
VITE_STORE_API_URL=
