[TEMPLATE]
# Email Configuration (para envío de planes)
# Gmail: activa 2FA y usa una contraseña de aplicación, no tu contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion

# Puerto del servidor
PORT=5000

# Firebase
# Opcion A (recomendada): descarga la clave de servicio desde la consola de
# Firebase (Configuracion del proyecto > Cuentas de servicio > Generar nueva
# clave privada) y guardala como firebase-key.json en la raiz del proyecto.
# Opcion B: rellena las tres variables de abajo con los datos de esa clave.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Ruta alternativa para la clave de servicio (relativa a la raiz del proyecto)
# FIREBASE_KEY_PATH=firebase-key.json

# Los administradores se gestionan en Firestore, en la coleccion admins.
# No se configura ningun email de administrador en el backend.

# IA del asistente (pon UNA de las dos claves; si no hay ninguna, el asistente
# funciona con respuestas locales simplificadas)
OPENAI_API_KEY=sk-proj-tu_clave_aqui
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest

# Clave estable para firmar confirmaciones de la IA administrativa (secreto)
ADMIN_AI_CONFIRM_SECRET=
